# Projects and examples are generated by their build.py: keep the source, not the output.
projects/*/*
!projects/*/build.py
!projects/*/*.md
examples/*/*
!examples/*/build.py
!examples/*/*.md
# prepare() copies DESIGN.md into each project; the source is video/DESIGN.md
projects/*/DESIGN.md
examples/*/DESIGN.md
__pycache__/
