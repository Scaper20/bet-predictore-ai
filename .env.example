# ---------------------------------------------------------------------------
# Football data providers
#
# None of these are required to run the app: TheSportsDB's public test key is
# used by default, which returns real live scores and real fixtures but caps
# most list endpoints at a handful of rows. Configuring either of the first two
# lifts that ceiling substantially.
# ---------------------------------------------------------------------------

# football-data.org — recommended. Free tier covers the top European
# competitions with no result truncation. https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# API-Football (api-sports.io) — widest coverage, and the only one of the three
# that carries the NPFL and CAF competitions properly.
# https://www.api-football.com/
API_FOOTBALL_KEY=

# TheSportsDB — a paid key removes the public-key result caps.
# https://www.thesportsdb.com/pricing
THESPORTSDB_API_KEY=

# ---------------------------------------------------------------------------
# AI match briefings (optional)
#
# Without this the app writes its match analysis deterministically from the
# fitted model, which is fully functional. With it, Claude rewrites that
# briefing into sharper prose — grounded in the same numbers, never inventing
# statistics of its own.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WhatsApp community
#
# Without this, the promo strip on the homepage, the timed popup, and the
# "join" section in Account > Preferences all render nothing — there's no
# broken "join" button pointing nowhere. Create the community by hand in
# WhatsApp (Communities > New community > Create), get its invite link
# from the community's own info screen, and set it here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical domain used in metadata, sitemap.xml, robots.txt and the Paystack
# checkout callback URL. Set this to your real custom domain once you have
# one. Until then it's safe to leave unset on Vercel — it falls back to
# Vercel's own NEXT_PUBLIC_VERCEL_URL (your actual deployment URL), never to
# a placeholder domain nobody owns. Only falls back to localhost outside
# Vercel (plain local dev).
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase (accounts, personalization, subscriptions)
#
# Without these, the app runs exactly as before: live scores, fixtures and
# predictions all work with no account required. /account/* pages show a
# "not configured" message instead of erroring, and every paid-tier feature
# gate resolves to the free tier.
# ---------------------------------------------------------------------------

# Project Settings > API Keys in your Supabase dashboard. Supabase is
# mid-migration from anon/service_role keys to publishable/secret keys — new
# projects show the new names by default, and the code accepts either (the
# newer name wins if both are set). Both forms are drop-in equivalents for
# the same client constructors, so pick whichever your dashboard shows you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=          # legacy name — use this if that's what your dashboard shows

# Server-only, bypasses Row Level Security. NEVER add a NEXT_PUBLIC_ prefix
# to this one — that would ship it to every visitor's browser. Used only by
# the Paystack webhook and the scheduled prediction-logging/settlement jobs
# (see src/lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=              # legacy name — use this if that's what your dashboard shows

# Run `supabase/migrations/0001_init.sql` against your project (via the SQL
# editor or the Supabase CLI) before setting the vars above.

# ---------------------------------------------------------------------------
# Paystack (Weekend Pass / Pro / VIP billing)
#
# Without these, /account/billing shows the plans but checkout is disabled.
# ---------------------------------------------------------------------------

# Settings > API Keys & Webhooks in your Paystack dashboard. Use a test key
# (sk_test_...) until you're ready to take real payments.
PAYSTACK_SECRET_KEY=

# Plan codes from Settings > Plans (Paystack dashboard) — Pro and VIP are
# recurring, so each needs a Plan object created there first. The Weekend
# Pass is a one-off charge and has no plan code.
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_YEARLY_PLAN_CODE=
PAYSTACK_VIP_MONTHLY_PLAN_CODE=

# ---------------------------------------------------------------------------
# Resend (transactional email — welcome, payment receipts, ticket replies,
# cancellation confirmations)
#
# Without this, every email send is a no-op (logged, not thrown) — the app
# functions identically, just silently, same degrade-gracefully convention
# as the Paystack/Supabase sections above.
# ---------------------------------------------------------------------------

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain verified in Resend (Domains > Add Domain), which means
# adding the SPF/DKIM records Resend gives you to your DNS — same place you
# added the Search Console TXT record (Vercel's dashboard, since
# betrix.com.ng's nameservers point there, not WhoGoHost's).
EMAIL_FROM="BetriX <hello@betrix.com.ng>"

# Where "a new support ticket was opened" notifications land (see
# src/app/api/support/thread/route.ts). Defaults to support@betrix.com.ng —
# only worth setting if you want them somewhere else.
#
# Actually RECEIVING mail at that address, and checking it from Gmail, is a
# one-time setup outside this codebase — Resend sends outbound only, it
# doesn't host an inbox:
#   1. Free route: sign up at improvmx.com (or a similar forwarding
#      service), add support@betrix.com.ng forwarding to your own Gmail
#      address, then add the MX record it gives you in Vercel's DNS
#      dashboard (same place as the SPF/DKIM records above). Mail sent to
#      support@ now arrives straight in your Gmail inbox.
#   2. To also SEND as support@betrix.com.ng from inside Gmail (not just
#      receive), add it under Gmail Settings > Accounts > "Send mail as" —
#      ImprovMX's free tier includes the SMTP credentials that step asks
#      for. Google Workspace is the paid alternative if you'd rather have a
#      real hosted mailbox instead of forwarding.
SUPPORT_INBOX_EMAIL="support@betrix.com.ng"

# Where "today's WhatsApp digest is ready" notifications land (see
# src/app/api/cron/whatsapp-digest). Optional — defaults to
# SUPPORT_INBOX_EMAIL above, only worth setting if you want these
# somewhere else. See /admin/whatsapp-digest for the actual message text —
# this email is just the "go paste it" nudge, not the content itself.
WHATSAPP_DIGEST_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Track Record page (predictions logging + settlement)
#
# Requires Supabase (above) plus migration 0002. Without this, /track-record
# shows a "not available yet" message and no picks are logged.
# ---------------------------------------------------------------------------

# Any long random string. Required by src/app/api/cron/settle-predictions —
# Vercel Cron sends this as `Authorization: Bearer <value>` automatically once
# both this var and vercel.json's cron entry are in place; the route rejects
# any request without a matching header, since (unlike the rest of this app's
# optional config) it writes to the database.
CRON_SECRET=

# SportAPI7 via RapidAPI. Optional: only used by scripts/backfill-history.ts,
# for the competitions football-data.co.uk does not archive (NPFL, CAF, UCL).

# parse.bot, for SportyBet prices. Optional: without it the value layer simply
# shows no book price, exactly as it does before a user types one in.
PARSEBOT_API_KEY=

# ---------------------------------------------------------------------------
# SportyBet booking codes (src/lib/booking/sportybet-booking.ts)
#
# Off by default, and turning it on is a business decision, not a technical
# one: unlike the odds above, this drives SportyBet's own public bet-slip
# builder with a headless browser to produce a real booking code. There is no
# official API for this. It very likely breaches SportyBet's terms of service
# even though it only automates an anonymous, already-public action (no
# login, no funds moved) — this repo tried a smaller version of the same idea
# before and reversed it for that reason (see quick-slip.tsx in git history).
#
# Needs a Chromium binary at runtime. On Vercel this is automatic — the
# @sparticuz/chromium package ships one sized for a serverless function.
# Anywhere else (local dev, a self-hosted Node server), run
# `npx playwright install chromium` once first. Without that, or with this
# flag left unset, the feature simply reports "unavailable" — it never
# breaks the page.
SPORTYBET_BOOKING_ENABLED=

# ---------------------------------------------------------------------------
# Admin mail (src/app/admin/(protected)/mail, src/lib/admin-mail.ts)
#
# Send-only Gmail integration for ONE admin's own dashboard — not a general
# team feature. Lets that admin send email from their own connected Google
# account, or as support@betrix.com.ng if that's already set up as a
# verified "Send As" alias in that Gmail account (Gmail Settings > Accounts).
# It never requests access to read anything already in that inbox.
#
# Requires an OAuth client in Google Cloud Console with the Gmail API
# enabled — Client ID + secret below, and this deployment's own
# <site>/api/admin/mail/callback added under "Authorized redirect URIs".
# Leave the OAuth consent screen in Testing mode with the allowed admin's
# email (below) added as a test user: that skips Google's app-verification
# review entirely, since this is never used by the public, only that one
# person.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# The one admin account (their login email on THIS site, not necessarily the
# Gmail address they connect) allowed to use this feature. Every other admin
# never even sees it in the nav. Leave unset and the whole feature is off.
ADMIN_MAIL_ALLOWED_EMAIL=
